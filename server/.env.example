# .env.example → .env 로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 키 만들기: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"

# 개발: SQLite / 시연: mysql+pymysql://user:pw@localhost:3306/seungcurity?charset=utf8mb4
DATABASE_URL=sqlite:///./dev.db

# 무작위 32바이트 이상 (위 명령 결과를 그대로 써도 된다)
JWT_SECRET=

# base64로 인코딩한 32바이트 (AES-256 키)
PII_KEY=

# 관리자 API용 무작위 문자열
ADMIN_TOKEN=

UPLOAD_DIR=./uploads

# 없으면 ./demo/demo_data.sample.json 을 쓴다
DEMO_DATA=../db/demo_data.json
